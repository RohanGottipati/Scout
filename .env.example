# Backboard.io API key (required for live research; without it only the demo idea returns data)
BACKBOARD_API_KEY=your_backboard_api_key_here

# Backboard API base URL (optional, defaults to https://app.backboard.io/api)
BACKBOARD_URL=https://app.backboard.io/api

# Existing Backboard assistant ID (optional; otherwise one is created and cached in backend/cache/assistant_id.txt)
BACKBOARD_ASSISTANT_ID=

# LLM used through Backboard (optional, defaults to openai / gpt-4o)
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL_NAME=gpt-4o

# Backend port (optional, defaults to 3001)
PORT=3001
